"""build_bazel_rules_nodejs — Bazel module definition.

The module must keep the name `build_bazel_rules_nodejs` because the BUILD files
generated by `yarn_install`/`npm_install` emit literal
`load("@build_bazel_rules_nodejs//:index.bzl", ...)` statements.
"""

module(
    name = "build_bazel_rules_nodejs",
    version = "4.4.5",
    compatibility_level = 1,
)

# @platforms is referenced by //toolchains/node:BUILD.bazel.
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

node = use_extension("//:extensions.bzl", "node")

# The node/yarn versions come from a `node.toolchain(...)` tag in the root
# module; without one the extension falls back to the rules' built-in defaults.
use_repo(
    node,
    "nodejs",
    "nodejs_darwin_amd64",
    "nodejs_darwin_amd64_config",
    "nodejs_darwin_arm64",
    "nodejs_darwin_arm64_config",
    "nodejs_linux_amd64",
    "nodejs_linux_amd64_config",
    "nodejs_linux_arm64",
    "nodejs_linux_arm64_config",
    "nodejs_linux_ppc64le",
    "nodejs_linux_ppc64le_config",
    "nodejs_linux_s390x",
    "nodejs_linux_s390x_config",
    "nodejs_windows_amd64",
    "nodejs_windows_amd64_config",
)

register_toolchains(
    "//toolchains/node:node_darwin_amd64_toolchain",
    "//toolchains/node:node_darwin_arm64_toolchain",
    "//toolchains/node:node_linux_amd64_toolchain",
    "//toolchains/node:node_linux_arm64_toolchain",
    "//toolchains/node:node_linux_ppc64le_toolchain",
    "//toolchains/node:node_linux_s390x_toolchain",
    "//toolchains/node:node_windows_amd64_toolchain",
)
